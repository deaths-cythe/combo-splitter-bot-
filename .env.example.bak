# Required
BOT_TOKEN=123456:ABCDEF-your-token-here

# Optional: point at a self-hosted local Bot API server (see README)
# Leave blank to use https://api.telegram.org
# Example: http://localhost:8081
TELEGRAM_API_BASE_URL=

# Limits (MB)
MAX_DOWNLOAD_MB=20
MAX_UPLOAD_MB=50

# Where to stage uploaded files. Wiped per job.
TEMP_DIR=./tmp

LOG_LEVEL=INFO
DEFAULT_PREVIEW_LINES=10
MAX_PARTS=100